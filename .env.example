# Конфигурация базы данных
DB_NAME=geopoints
DB_USER=geopoints_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# Использовать PostGIS для пространственных запросов (установите 1 для включения, 0 для резервного варианта SQLite)
USE_POSTGIS=1

# Настройки безопасности Django
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Windows: пути OSGeo4W для GDAL/GEOS (настройте в соответствии с вашей установкой)
# Пример: C:\OSGeo4W или C:\Users\YourName\AppData\Local\Programs\OSGeo4W
OSGEO4W_ROOT=C:\OSGeo4W
GDAL_LIBRARY_PATH=${OSGEO4W_ROOT}\bin\gdal312.dll
GEOS_LIBRARY_PATH=${OSGEO4W_ROOT}\bin\geos_c.dll
PROJ_LIB=${OSGEO4W_ROOT}\share\proj
GDAL_DATA=${OSGEO4W_ROOT}\share\gdal

# Linux/Mac: обычно определяются автоматически, раскомментируйте при необходимости
# GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so
